{
  "name": "production-data-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:tolerances": "npm run dev --workspace @pdm/tolerances",
    "dev:templates": "npm run dev --workspace @pdm/templates",
    "dev:firmwares": "npm run dev --workspace @pdm/firmwares",
    "dev:soldering-programs": "npm run dev --workspace @pdm/soldering-programs",
    "dev:notifications": "npm run dev --workspace @pdm/notifications",
    "build:tolerances": "npm run build --workspace @pdm/tolerances",
    "build:templates": "npm run build --workspace @pdm/templates",
    "build:firmwares": "npm run build --workspace @pdm/firmwares",
    "build:soldering-programs": "npm run build --workspace @pdm/soldering-programs",
    "build:notifications": "npm run build --workspace @pdm/notifications",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint packages/shared/src && npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
